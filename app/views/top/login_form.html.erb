<h1>ログイン</h1>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<%= form_with url: top_login_path, method: :post do |f| %>
  <p>
    <%= f.label :uid, "ユーザーID" %>
    <%= f.text_field :uid, required: true %>
  </p>

  <p>
    <%= f.label :pass, "パスワード" %>
    <%= f.password_field :pass, required: true %>
  </p>

  <%= f.submit "ログイン" %>
<% end %>

<%= link_to "新規登録", new_user_path %>
<%= link_to "戻る", root_path %>